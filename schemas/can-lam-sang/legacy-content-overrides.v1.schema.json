{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiutmc.com/schemas/can-lam-sang/legacy-content-overrides.v1.schema.json",
  "title": "HIU TMC Clinical Lab Legacy Content Overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overrides"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "path",
          "original_sha256",
          "op",
          "reason",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
          },
          "path": {
            "type": "string",
            "pattern": "^investigations\\[[0-9]+\\]\\.(name|result)$"
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "op": {
            "enum": [
              "remove_substring",
              "move_to_after_submission"
            ]
          },
          "remove_substring": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "CHUA_DUYET"
          }
        }
      }
    }
  }
}
