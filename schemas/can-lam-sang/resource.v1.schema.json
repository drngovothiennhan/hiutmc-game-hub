{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiutmc.com/schemas/can-lam-sang/resource.v1.schema.json",
  "title": "HIU TMC Clinical Lab Resource Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "resource_type",
    "source",
    "title",
    "organization",
    "year_version",
    "citation",
    "checked_date",
    "reviewer",
    "review_status",
    "license",
    "provenance_tags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "resource_type": {
      "enum": [
        "guideline",
        "article",
        "regulation",
        "textbook",
        "web",
        "other"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": [
        "string",
        "null"
      ]
    },
    "year_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "checked_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "enum": [
        "CHUA_DUYET",
        "DA_DUYET"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "DA_DUYET"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "year_version": {
            "type": "string",
            "minLength": 1
          },
          "checked_date": {
            "type": "string",
            "format": "date"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
