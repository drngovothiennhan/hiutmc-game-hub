{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiutmc.com/schemas/can-lam-sang/submission.v1.schema.json",
  "title": "HIU TMC Clinical Lab Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "case_id",
    "case_schema_version",
    "module",
    "answers",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "submission_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "case_schema_version": {
      "const": "1.0.0"
    },
    "module": {
      "enum": [
        "core",
        "cbc",
        "ecg_monitor",
        "xray",
        "auscultation"
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": true
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
